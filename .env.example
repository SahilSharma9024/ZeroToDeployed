# =================================================================
# KINETIX Sports & Fitness OS — Production Environment Variables
# =================================================================

# Port for Web Server (Use 80 for production AWS EC2, 5000 for local development)
PORT=5000

# JSON Web Token Secret for Athlete Sessions & QR Gate Pass Verification
JWT_SECRET=kinetix_super_secret_jwt_2026_sports_os

# -----------------------------------------------------------------
# 1. GROQ CLOUD LLM (100% Free at https://console.groq.com)
# Provides ultra-fast inference for the AI Personal Trainer
# Model: llama-3.3-70b-versatile
# Note: If left blank, the app falls back to local physiological reasoning!
# -----------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------
# 2. VECTORIZE HINDSIGHT AGENT PERSISTENT MEMORY
# Provides the 3-Phase Cognitive Architecture (Recall -> Reason -> Retain)
# Endpoint: https://api.hindsight.vectorize.io
# Note: If left blank, the app falls back to local SQLite persistent memory!
# -----------------------------------------------------------------
HINDSIGHT_API_KEY=
HINDSIGHT_ENDPOINT=https://api.hindsight.vectorize.io

